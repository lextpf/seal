# Build output (track the empty dir via .gitkeep; ignore its contents)
build/*
!build/.gitkeep
build-*/

# Generated documentation. main.html is the authored mkdocs theme override;
# qml.qdoc is the authored QDoc module overview.
docs/*
!docs/main.html
!docs/qml.qdoc
site/*
!site/.gitkeep

# Knowledge-graph / analysis output
graphify-out/
.understand-anything/

# Python
__pycache__/
*.pyc

# Application assets
assets/

# Browser extension / local artifacts
com.seal.fill*.json
*.pem
*.pfx
*.p12
*.crx
*.reg

# Local scratch output
.tmp/
